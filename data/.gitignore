# Documents as obtained, and their extractions: local, SharePoint, or FRDR (conventions §2)
primary-sources/
extracted/

# Written by the build, never committed (Q2): processed/ and model/, apart from model/'s README
processed/
model/*
!model/README.md

# The folders from before the data layout move (phase 3). Keep these until every worktree
# has run tools/migrate_data_layout.py, so nothing left in them gets committed by accident.
/raw_data/
/processed_data/
/model_inputs/
/calibration/

# Python cache
__pycache__/
*.py[cod]
