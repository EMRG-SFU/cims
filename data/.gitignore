# Raw source data — store locally or on SharePoint
raw_data/*
!raw_data/.gitkeep

# Generated outputs — do not commit
processed_data/energy_prices/*
!processed_data/energy_prices/.gitkeep

processed_data/nrcan/*
!processed_data/nrcan/.gitkeep

# Calibration outputs — do not commit
calibration/residential/*
!calibration/residential/.gitkeep

# Model input outputs — do not commit
model_inputs/residential/*
!model_inputs/residential/.gitkeep

# Python cache
__pycache__/
*.py[cod]
