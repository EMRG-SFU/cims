# Raw source data — store locally or on SharePoint
raw_data/*
!raw_data/.gitkeep

# Generated outputs — do not commit
processed_data/**/*.csv
calibration/**/*.csv
model_inputs/**/*.csv
model_inputs/**/*.xlsx

# The technology database build also writes markdown reviews and a workbook beside its CSVs
processed_data/technology_database/

# Python cache
__pycache__/
*.py[cod]
